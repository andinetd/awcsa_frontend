# Backend API Base URL (e.g. http://localhost:3000/api or https://api.yourdomain.com/api)
NEXT_PUBLIC_BASE_URL=http://localhost:3000/api

# Secure Cookies: Set to 'true' in production (HTTPS) so cookies are only transmitted over TLS
NEXT_PUBLIC_SECURE_COOKIES=false

# Google reCAPTCHA v3 site key (matches backend RECAPTCHA_SITE_KEY)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# JWT Secret for middleware cryptographic signature validation (must match backend JWT_SECRET)
JWT_SECRET=this-secret-key-must-be-greater-than-sixteen-characters

# Sentry DSN for error and performance monitoring
NEXT_PUBLIC_SENTRY_DSN=https://fbbd871d9c72e3350dd3ba87db29792d@o4512301722435584.ingest.de.sentry.io/4512301797998672
